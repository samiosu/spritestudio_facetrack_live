{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spriteface.invalid/protocol/face-frame-v2",
  "title": "SpriteFace SF2 decrypted frame",
  "type": "object",
  "required": ["v", "type", "token", "client", "server", "seq", "tracking", "confidence", "head", "eyes", "mouth"],
  "properties": {
    "v": {"const": 1},
    "type": {"const": "frame"},
    "token": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"},
    "client": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "server": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "seq": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "tracking": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "head": {
      "type": "object", "required": ["yaw", "pitch", "roll"],
      "properties": {
        "yaw": {"type": "number", "minimum": -3.141593, "maximum": 3.141593},
        "pitch": {"type": "number", "minimum": -3.141593, "maximum": 3.141593},
        "roll": {"type": "number", "minimum": -3.141593, "maximum": 3.141593}
      }
    },
    "eyes": {
      "type": "object", "required": ["left", "right"],
      "properties": {"left": {"type": "number", "minimum": 0, "maximum": 1}, "right": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "mouth": {
      "type": "object", "required": ["open", "smile"],
      "properties": {"open": {"type": "number", "minimum": 0, "maximum": 1}, "smile": {"type": "number", "minimum": 0, "maximum": 1}}
    }
  }
}
